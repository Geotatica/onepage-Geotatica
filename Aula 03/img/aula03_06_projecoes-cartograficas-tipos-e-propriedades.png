a-end="1127" data-col-size="sm">04</td><td data-start="1127" data-end="1196" data-col-size="md"><code data-start="1129" data-end="1195">aula03_04_superficies-referencia-geoide-elipsoide-topografia.png</code></td><td data-start="1196" data-end="1224" data-col-size="sm">Superfícies de referência</td><td data-start="1224" data-end="1287" data-col-size="md">Comparação entre geoide, elipsoide e superfície topográfica</td></tr><tr data-start="1288" data-end="1410"><td data-start="1288" data-end="1293" data-col-size="sm">05</td><td data-start="1293" data-end="1337" data-col-size="md"><code data-start="1295" data-end="1336">aula03_05_datum-horizontal-vertical.png</code></td><td data-start="1337" data-end="1345" data-col-size="sm">Datum</td><td data-start="1345" data-end="1410" data-col-size="md">Esquema separando datum horizontal/geodésico e datum vertical</td></tr><tr data-start="1411" data-end="1536"><td data-start="1411" data-end="1416" data-col-size="sm">06</td><td data-start="1416" data-end="1453" data-col-size="md"><code data-start="1418" data-end="1452">aula03_06_sirgas-2000-brasil.png</code></td><td data-start="1453" data-end="1467" data-col-size="sm">SIRGAS 2000</td><td data-start="1467" data-end="1536" data-col-size="md">Brasil com rede de referência, satélites/GNSS e camadas alinhadas</td></tr><tr data-start="1537" data-end="1687"><td data-start="1537" data-end="1542" data-col-size="sm">07</td><td data-start="1542" data-end="1605" data-col-size="md"><code data-start="1544" data-end="1604">aula03_07_coordenadas-geograficas-paralelos-meridianos.png</code></td><td data-start="1605" data-end="1631" data-col-size="sm">Coordenadas geográficas</td><td data-start="1631" data-end="1687" data-col-size="md">Globo com paralelos, meridianos, Equador e Greenwich</td></tr><tr data-start="1688" data-end="1817"><td data-start="1688" data-end="1693" data-col-size="sm">08</td><td data-start="1693" data-end="1730" data-col-size="md"><code data-start="1695" data-end="1729">aula03_08_latitude-longitude.png</code></td><td data-start="1730" data-end="1753" data-col-size="sm">Latitude e longitude</td><td data-start="1753" data-end="1817" data-col-size="md">Esquema mostrando latitude norte/sul e longitude leste/oeste</td></tr><tr data-start="1818" data-end="1954"><td data-start="1818" data-end="1823" data-col-size="sm">09</td><td data-start="1823" data-end="1879" data-col-size="md"><code data-start="1825" data-end="1878">aula03_09_coordenadas-geograficas-vs-projetadas.png</code></td><td data-start="1879" data-end="1906" data-col-size="sm">Transição para projeções</td><td data-start="1906" data-end="1954" data-col-size="md">Comparação: graus no globo x metros no plano</td></tr><tr data-start="1955" data-end="2098"><td data-start="1955" data-end="1960" data-col-size="sm">10</td><td data-start="1960" data-end="2013" data-col-size="md"><code data-start="1962" data-end="2012">aula03_10_projecoes-cartograficas-distorcoes.png</code></td><td data-start="2013" data-end="2039" data-col-size="sm">Projeções cartográficas</td><td data-start="2039" data-end="2098" data-col-size="md">Terra curva sendo transformada em plano, com distorções</td></tr><tr data-start="2099" data-end="2239"><td data-start="2099" data-end="2104" data-col-size="sm">11</td><td data-start="2104" data-end="2165" data-col-size="md"><code data-start="2106" data-end="2164">aula03_11_tipos-projecoes-cilindrica-conica-azimutal.png</code></td><td data-start="2165" data-end="2186" data-col-size="sm">Tipos de projeções</td><td data-start="2186" data-end="2239" data-col-size="md">Três esquemas lado a lado: cilindro, cone e plano</td></tr><tr data-start="2240" data-end="2382"><td data-start="2240" data-end="2245" data-col-size="sm">12</td><td data-start="2245" data-end="2302" data-col-size="md"><code data-start="2247" data-end="2301">aula03_12_projecoes-pseudocilindricas-mapa-mundi.png</code></td><td data-start="2302" data-end="2322" data-col-size="sm">Projeções globais</td><td data-start="2322" data-end="2382" data-col-size="md">Mapa-múndi com exemplos como Robinson, Mollweide e Goode</td></tr><tr data-start="2383" data-end="2529"><td data-start="2383" data-end="2388" data-col-size="sm">13</td><td data-start="2388" data-end="2432" data-col-size="md"><code data-start="2390" data-end="2431">aula03_13_o-que-a-projecao-preserva.png</code></td><td data-start="2432" data-end="2459" data-col-size="sm">Propriedades preservadas</td><td data-start="2459" data-end="2529" data-col-size="md">Quadro visual: forma, área, distância, direção e equilíbrio visual</td></tr><tr data-start="2530" data-end="2654"><td data-start="2530" data-end="2535" data-col-size="sm">14</td><td data-start="2535" data-end="2581" data-col-size="md"><code data-start="2537" data-end="2580">aula03_14_utm-fusos-meridiano-central.png</code></td><td data-start="2581" data-end="2587" data-col-size="sm">UTM</td><td data-start="2587" data-end="2654" data-col-size="md">Globo dividido em fusos de 6° e destaque para meridiano central</td></tr><tr data-start="2655" data-end="2779"><td data-start="2655" data-end="2660" data-col-size="sm">15</td><td data-start="2660" data-end="2709" data-col-size="md"><code data-start="2662" data-end="2708">aula03_15_estrutura-utm-easting-northing.png</code></td><td data-start="2709" data-end="2725" data-col-size="sm">Estrutura UTM</td><td data-start="2725" data-end="2779" data-col-size="md">Grade UTM com Easting, Northing, fuso e hemisfério</td></tr><tr data-start="2780" data-end="2877"><td data-start="2780" data-end="2785" data-col-size="sm">16</td><td data-start="2785" data-end="2820" data-col-size="md"><code data-start="2787" data-end="2819">aula03_16_fusos-utm-brasil.png</code></td><td data-start="2820" data-end="2836" data-col-size="sm">UTM no Brasil</td><td data-start="2836" data-end="2877" data-col-size="md">Brasil atravessando fusos UTM 18 a 26</td></tr><tr data-start="2878" data-end="2997"><td data-start="2878" data-end="2883" data-col-size="sm">17</td><td data-start="2883" data-end="2925" data-col-size="md"><code data-start="2885" data-end="2924">aula03_17_primeira-decisao-no-sig.png</code></td><td data-start="2925" data-end="2942" data-col-size="sm">Decisão no SIG</td><td data-start="2942" data-end="2997" data-col-size="md">Fluxo: camada → CRS → medição → layout → publicação</td></tr><tr data-start="2998" data-end="3125"><td data-start="2998" data-end="3003" data-col-size="sm">18</td><td data-start="3003" data-end="3051" data-col-size="md"><code data-start="3005" data-end="3050">aula03_18_checklist-referencia-espacial.png</code></td><td data-start="3051" data-end="3069" data-col-size="sm">Checklist final</td><td data-start="3069" data-end="3125" data-col-size="md">Lista visual de conferência antes de publicar o mapa</td></tr></tbody></table><div class="sticky h-0 select-none end-(--thread-content-margin) self-end"><div class="absolute end-0 flex items-end"><span class="" data-state="closed"><button aria-label="Copiar tabela" class="hover:bg-token-bg-tertiary text-token-text-secondary my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-6d2147a0.svg#ce3544" fill="currentColor"></use></svg></button></span></div></div></div></div>
<hr data-start="3127" data-end="3130">
<h1 data-section-id="1bn02uu" data-start="3132" data-end="3169">Imagens que eu considero essenciais</h1>
<p data-start="3171" data-end="3247">Para não pesar a página, eu começaria com estas <strong data-start="3219" data-end="3246">12 imagens obrigatórias</strong>:</p>
